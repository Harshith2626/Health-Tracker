# Database: Supports SQLite (file:./dev.db) for single-node / local, or PostgreSQL (postgresql://...) for cloud (Render/Neon/Supabase)
DATABASE_URL="file:./dev.db"

# JWT Secret for session authentication
JWT_SECRET="replace-with-a-long-random-secure-secret-in-production"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV="production"

# Allowed CORS Origins (comma-separated, or * for permissive)
CORS_ORIGIN="http://localhost:5173,https://your-frontend-domain.vercel.app,*"

# AI Intelligence Keys (supports Anthropic Claude, Google Gemini, and OpenAI)
# If no key is set, the built-in clinical intelligence engine handles queries automatically.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
